# Copy to .env and fill in. Loaded with: uv run --env-file .env ...
# Never commit .env.

# Shared secret sent by the web app in the X-Device-Token header.
# Must match DEVICE_TOKEN in apps/web/.env. At least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=

# Folder the registry watches for new slides. Must exist. On the desktop,
# keep it inside the WSL2 filesystem (e.g. ~/mil/acquisition), not /mnt/c (D-007).
ACQUISITION_DIR=

# Device-owned data: SQLite database, feature cache, and per-job outputs.
# Created if missing. Keep it outside ACQUISITION_DIR.
DATA_DIR=

# Optional. Folder holding models/manifest.json and the fetched weights/.
# Defaults to services/inference/models. Fetch weights with:
#   uv run python scripts/fetch_models.py
# The service refuses to start if a weight file is missing or its SHA-256
# does not match the manifest (REQ-016).
MODELS_DIR=

# Optional. DataLoader worker processes for feature extraction (default 8;
# 0 reads patches in the job thread, much slower). D-045.
FEATURE_WORKERS=8

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
