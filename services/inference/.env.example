# Copy to .env and fill in. Loaded with: uv run --env-file .env ...
# Never commit .env.

# Shared secret sent by the web app in the X-Device-Token header.
# Must match DEVICE_TOKEN in apps/web/.env. At least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=

# Folder the registry watches for new slides. Must exist. On the desktop,
# keep it inside the WSL2 filesystem (e.g. ~/mil/acquisition), not /mnt/c (D-007).
ACQUISITION_DIR=

# Device-owned data: SQLite database now, feature cache later. Created if
# missing. Keep it outside ACQUISITION_DIR.
DATA_DIR=

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
